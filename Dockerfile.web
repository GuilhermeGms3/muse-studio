FROM node:22-alpine AS build

WORKDIR /app

COPY package.json ./
RUN npm install --package-lock=false --no-audit --no-fund

COPY . .

ARG VITE_MUSIC_OS_API_URL=http://127.0.0.1:8081/api/v1
ENV VITE_MUSIC_OS_API_URL=${VITE_MUSIC_OS_API_URL}
ENV NITRO_PRESET=node-server

RUN npm run build

FROM node:22-alpine

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/GuilhermeGms3/muse-studio"

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

COPY --from=build --chown=node:node /app/.output ./.output

USER node

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
