FROM maven:3.9-eclipse-temurin-21-alpine AS build

WORKDIR /app

COPY backend/pom.xml backend/pom.xml
RUN mvn -f backend/pom.xml dependency:go-offline -q

COPY backend backend
RUN mvn -f backend/pom.xml package -q -DskipTests

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/GuilhermeGms3/muse-studio"

RUN addgroup -S musicos && adduser -S musicos -G musicos \
    && mkdir -p /app/data \
    && chown -R musicos:musicos /app

COPY --from=build --chown=musicos:musicos /app/backend/target/music-os-api-*.jar /app/music-os-api.jar

ENV SERVER_ADDRESS=0.0.0.0
ENV MUSIC_OS_API_PORT=8081
ENV MUSIC_OS_DATA_DIR=/app/data
ENV SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/music-os

USER musicos

EXPOSE 8081

CMD ["java", "-jar", "/app/music-os-api.jar"]
